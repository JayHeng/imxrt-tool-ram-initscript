void InitSysPll2Pfd2()
{
    unsigned int val;
    unsigned int stable;

    // ANADIG_PLL_PLL_528_PFD
    val = MEM_ReadU32(0x40C84270);
    if (((val & 0x800000) != 0) || (((val & 0x3F0000) >> 16) != 29))
    {
        stable = val & 0x400000;

        val |= 0x800000;
        MEM_WriteU32(0x40C84270, val);

        val = MEM_ReadU32(0x40C84270);
        val &= ~0x3F0000;
		// frac = 29 (range 13-35)
        val |= 29 << 16;
        MEM_WriteU32(0x40C84270, val);

        val = MEM_ReadU32(0x40C84250);
        val ^= 0x8;
        MEM_WriteU32(0x40C84250, val);

        val = MEM_ReadU32(0x40C84270);
        val &= ~0x800000;
        MEM_WriteU32(0x40C84270, val);
        do
        {
            val = MEM_ReadU32(0x40C84270) & 0x400000;
        } while (val == stable);
    }
    else
    {
        Report("syspll2 pfd2 has been initialized already");
        val &= ~0x800000;
        MEM_WriteU32(0x40C84270, val);
    }
}

void InitSysPll2()
{
    unsigned int val;

    // ANADIG_PLL_PLL_528_CTRL
    val = MEM_ReadU32(0x40C84240);
    if (val & 0x800000)
    {
        // SysPll2 has been initialized
        val &= ~0x40000000;
        MEM_WriteU32(0x40C84240, val);
        Report("syspll2 has been initialized already");
        return;
    }

    val = MEM_ReadU32(0x40C84270);
    val |= 0x80808080;
    MEM_WriteU32(0x40C84270, val);

    val = MEM_ReadU32(0x40C84240);
    val &= ~(0x802000);
    val |= 0x40000000;
    MEM_WriteU32(0x40C84240, val);
    
    // ANADIG_PLL_PLL_528_MFN
    MEM_WriteU32(0x40C84280, 0);
    // ANADIG_PLL_PLL_528_MFI
    MEM_WriteU32(0x40C84290, 22);
    // ANADIG_PLL_PLL_528_MFD
    MEM_WriteU32(0x40C842A0, 0x0FFFFFFF);

    // ANADIG_PLL_PLL_528_CTRL
    MEM_WriteU32(0x40C84240, 0x8 | 0x40000000);
    SYS_Sleep(30);

    // ANADIG_PLL_PLL_528_CTRL
    val = MEM_ReadU32(0x40C84240);
    val |= 0x800000 | 0x800;
    MEM_WriteU32(0x40C84240, val);
    SYS_Sleep(250);

    val = MEM_ReadU32(0x40C84240);
    val &= ~0x800;
    MEM_WriteU32(0x40C84240, val);

    do
    {
        val = MEM_ReadU32(0x40C84240);
    } while ((val & 0x20000000) == 0);

    val |= 0x2000;
    MEM_WriteU32(0x40C84240, val);

    val &= ~0x40000000;
    MEM_WriteU32(0x40C84240, val);
}

// W956A8MBYA HyperRam initialization.

void _Flexspi_pin_mux()
{
  Report("EMC_B2_xx Pad PIN mux started...");
  
    ///////////////////
    // Hyper RAM START
    //////////////////

    // IOMUXC_SetPinMux () 
    MEM_WriteU32(0x400E8108, 0x00000014);		// IOMUXC_GPIO_EMC_B2_20_FLEXSPI2_A_DATA07
    MEM_WriteU32(0x400E834C, 0x0A);
	
    MEM_WriteU32(0x400E8104, 0x00000014);		// IOMUXC_GPIO_EMC_B2_19_FLEXSPI2_A_DATA06
    MEM_WriteU32(0x400E8348, 0x0A);
	
    MEM_WriteU32(0x400E8100, 0x00000014);		// IOMUXC_GPIO_EMC_B2_18_FLEXSPI2_A_DATA05
    MEM_WriteU32(0x400E8344, 0x0A);
	
    MEM_WriteU32(0x400E80FC, 0x00000014);		// IOMUXC_GPIO_EMC_B2_17_FLEXSPI2_A_DATA04
    MEM_WriteU32(0x400E8340, 0x0A);
	
    MEM_WriteU32(0x400E80E8, 0x00000014);		// IOMUXC_GPIO_EMC_B2_12_FLEXSPI2_A_DQS
    MEM_WriteU32(0x400E832C, 0x0A);


    MEM_WriteU32(0x400E80E4, 0x00000014);		// IOMUXC_GPIO_EMC_B2_11_FLEXSPI2_A_SS0_B
    MEM_WriteU32(0x400E8328, 0x0A);

    MEM_WriteU32(0x400E80E0, 0x00000014);		// IOMUXC_GPIO_EMC_B2_10_FLEXSPI2_A_SCLK
    MEM_WriteU32(0x400E858C, 0x00000000);
    MEM_WriteU32(0x400E8324, 0x0A);

    MEM_WriteU32(0x400E80EC, 0x00000014);		// IOMUXC_GPIO_EMC_B2_13_FLEXSPI2_A_DATA00
    MEM_WriteU32(0x400E857C, 0x00000000);
    MEM_WriteU32(0x400E8330, 0x0A);

    MEM_WriteU32(0x400E80F0, 0x00000014);		// IOMUXC_GPIO_EMC_B2_14_FLEXSPI2_A_DATA01
    MEM_WriteU32(0x400E8580, 0x00000000);
    MEM_WriteU32(0x400E8334, 0x0A);

    MEM_WriteU32(0x400E80F4, 0x00000014);		// IOMUXC_GPIO_EMC_B2_15_FLEXSPI2_A_DATA02
    MEM_WriteU32(0x400E8584, 0x00000000);
    MEM_WriteU32(0x400E8338, 0x0A);

    MEM_WriteU32(0x400E80F8, 0x00000014);		// IOMUXC_GPIO_EMC_B2_16_FLEXSPI2_A_DATA03
    MEM_WriteU32(0x400E8588, 0x00000000);
    MEM_WriteU32(0x400E833C, 0x0A);

    ///////////////////
    //Hyper RAM END
    ///////////////////  

  Report("EMC_B2_xx PIN mux finished!");
}

void _Flexspi_reset()
{
  unsigned int reg;
   reg = MEM_ReadU32(0x400D0000);
  MEM_WriteU32(0x400D0000, (reg | 0x1));   
  do
  {
    reg = MEM_ReadU32(0x400D0000);
  }while((reg & 0x1) != 0); 
}

void Clock_Init() 
{
    unsigned int reg;
    unsigned int val;

    InitSysPll2();
    InitSysPll2Pfd2();

    // Set FLEXSPI2 root clock
    reg = 0x40CC1080;
    // Use sys pll2 pfd2 divided by 1: 327.72 MHz, which results FlexSPI to 163.86 MHz.
    val = 0x600;
    MEM_WriteU32(reg, val);

  Report("Clock Init Done");
}

void _hyper_Init()
{
  // Config FlexSPI2 Registers								

  MEM_WriteU32(0x400D0000, 0xFFFF80C0); // MCR0				// 0xffff80c0 
  _Flexspi_reset();
  MEM_WriteU32(0x400D0000, 0xFFFF3032); // MCR0				// 0xffff3032
  MEM_WriteU32(0x400D0004, 0xFFFFFFFF); // MCR1				// 0xffffffff
  MEM_WriteU32(0x400D0008, 0x200001f7); // MCR2				// 0x200001F7
  MEM_WriteU32(0x400D000C, 0x00000038); // AHBCR			// 0x00000078
  MEM_WriteU32(0x400D0020, 0x80000020); // AHBRXBUFCR00		
  MEM_WriteU32(0x400D0024, 0x80000020); // AHBRXBUFCR01		
  MEM_WriteU32(0x400D0028, 0x80000020); // AHBRXBUFCR02		
  MEM_WriteU32(0x400D002C, 0x80000020); // AHBRXBUFCR03		
  MEM_WriteU32(0x400D00B8, 0x00000000); // IPRXFCR			// 0x00000000
  MEM_WriteU32(0x400D00BC, 0x00000000); // IPTXFCR			// 0x00000000
  MEM_WriteU32(0x400D0060, 0x00002000); // FLASHA1CR0		// 0x00002000
  MEM_WriteU32(0x400D0070, 0x00021C63); // FLASHA1CR1		// 0x00021c63
  MEM_WriteU32(0x400D0080, 0x00000100); // FLASHA1CR2		// 0x00000100
  MEM_WriteU32(0x400D00C0, 0x00000079); // DLLCR			// 0x00000079
//  MEM_WriteU32(0x400D00C0, 0x00001D00); // DLLCR			// 
  MEM_WriteU32(0x400D0094, 0x00000000); // FLASHA1CR4 		// 
  MEM_WriteU32(0x400D0094, 0x00000004); // FLASHA1CR4 		// 0x00000004
  MEM_WriteU32(0x400D0000, 0xFFFF3030); // MCR0				// 0xffff3030	/* Exit stop mode. */
  MEM_WriteU32(0x400D0018, 0x5AF05AF0); // LUTKEY			// 0x5af05af0
  MEM_WriteU32(0x400D001C, 0x00000002); // LUTCR			// 0x00000002
  MEM_WriteU32(0x400D0200, 0x8b1887a0); // LUT[0]			//0x8B1887A0   
  MEM_WriteU32(0x400D0204, 0xb7078f10); // LUT[1]			//0xb7078f10
  MEM_WriteU32(0x400D0208, 0x0000a704); // LUT[2]			//0x0000A704
  MEM_WriteU32(0x400D020C, 0x00000000); // LUT[3] 		//0x00000000
  MEM_WriteU32(0x400D0210, 0x8b188720); // LUT[4]			//0x8B188720
  MEM_WriteU32(0x400D0214, 0xb7078f10); // LUT[5]			//0xb7078f10
  MEM_WriteU32(0x400D0218, 0x0000a304); // LUT[6]			//0x0000A304
  MEM_WriteU32(0x400D021C, 0x00000000); // LUT[7]			//0x00000000
  MEM_WriteU32(0x400D0220, 0x8b1887e0); // LUT[8]			//0x8B1887E0
  MEM_WriteU32(0x400D0224, 0xb7078f10); // LUT[9]			//0xb7078f10
  MEM_WriteU32(0x400D0228, 0x0000a704); // LUT[10]		//0x0000A704
  MEM_WriteU32(0x400D022C, 0x00000000); // LUT[11]		//0x00000000
  MEM_WriteU32(0x400D0230, 0x8b188760); // LUT[12]		//0x8B188760
  MEM_WriteU32(0x400D0234, 0xa3048f10); // LUT[13]		//0xa3048f10
  MEM_WriteU32(0x400D0238, 0x00000000); // LUT[14]		//0x00000000
  MEM_WriteU32(0x400D023C, 0x00000000); // LUT[15]		//0x00000000
  MEM_WriteU32(0x400D0240, 0x00000000); // LUT[16]		//0x00000000
  MEM_WriteU32(0x400D0244, 0x00000000); // LUT[17]		//0x00000000
  MEM_WriteU32(0x400D0248, 0x00000000); // LUT[18]		//0x00000000
  MEM_WriteU32(0x400D024C, 0x00000000); // LUT[19]		//0x00000000
  MEM_WriteU32(0x400D0018, 0x5AF05AF0); // LUTKEY			//0x5AF05AF0
  MEM_WriteU32(0x400D001C, 0x00000001); // LUTCR			//0x00000001
 
  _Flexspi_reset();
  
  Report("HyperRAM init done\n");
}

void RestoreFlexRAM()
{
    unsigned int base;
    unsigned int value;

    base = 0x400E4000;

    value = MEM_ReadU32(base + 0x44);
    value &= ~(0xFFFF);
    value |= 0xFFAA;
    MEM_WriteU32(base + 0x44, value);

    value = MEM_ReadU32(base + 0x48);
    value &= ~(0xFFFF);
    value |= 0xFFAA;
    MEM_WriteU32(base + 0x48, value);

    value = MEM_ReadU32(base + 0x40);
    value &= ~(0xFF << 8);
    value |= 0x7 | (0xAA << 8);
    MEM_WriteU32(base + 0x40, value);
    Report("FlexRAM configuration is restored");
}    

void ReleaseCM4(void) {
    MEM_WriteU32(0x40C04000, 1);
    Report("CM4 is released");
}

void CM7VectReset(void) {
    MEM_WriteU32(0xE000ED0C, 0x5FA0001);
    SYS_Sleep(10);
    Report("CM7 Vector Reset");
}

void CM7SrcReset(void) {
    unsigned int t;

    /* Issue M7 reset */
    MEM_WriteU32(0x40c042a4, 1);

    /* Check M7 reset status */
    t = MEM_ReadU32(0x40c042b0);
    t &= 0x1;
    while (t)
    {
        t = MEM_ReadU32(0x40c042b0);
        t &= 0x1;
    }
    SYS_Sleep(10);
    Report("CM7 SRC reset");
}

void ResetCM7(void) {
    CM7SrcReset();
}

void ResetDisplayMix()
{
    unsigned int t;

    /* Issue DISPLAYMIX reset */
    MEM_WriteU32(0x40c04224, 1);

    /* Check DISPLAYMIX reset status */
    t = MEM_ReadU32(0x40c04230);
    t &= 0x1;
    while (t)
    {
        t = MEM_ReadU32(0x40c04230);
        t &= 0x1;
    }
    SYS_Sleep(10);
    Report("DISPLAYMIX SRC reset");
}

void ResetPeripherals()
{
    ResetDisplayMix();
}

void InitTarget(void) {
    CPU = CORTEX_M7;
    // Manually configure AP
    JLINK_CORESIGHT_AddAP(0, CORESIGHT_AHB_AP); // First AP is a AHB-AP
    JLINK_CORESIGHT_AddAP(1, CORESIGHT_AHB_AP);
    JLINK_CORESIGHT_AddAP(2, CORESIGHT_APB_AP);
    CORESIGHT_IndexAHBAPToUse = 0;

    // Dummy read
    JLINK_CORESIGHT_ReadAP(JLINK_CORESIGHT_AP_REG_IDR);
    SYS_Sleep(10);

    // Disable system reset caused by sysrstreq from each core
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, 0x40C04004);
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_DATA, 0xF << 10);
}

void ResetTarget(void) {
    unsigned int r;
    JLINK_TARGET_Halt();
    ResetPeripherals();
    ResetCM7();
    r = JLINK_TARGET_IsHalted();
    if (r == 0)
        r = JLINK_TARGET_Halt();
    r = JLINK_TARGET_IsHalted();
    if (r == 0)
        Report("CM7 is halted");
}

void SetupTarget(void) {
    RestoreFlexRAM();
    Clock_Init();
    _Flexspi_pin_mux();
    _hyper_Init();  
}

void AfterResetTarget(void) {
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, 0x40C04004);
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_DATA, 0xF << 10);
    RestoreFlexRAM();
    Clock_Init();
    _Flexspi_pin_mux();
    _hyper_Init();  
}
